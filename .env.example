# Environment variables template for Studioza

# Backend Database
# Local SQLite: "file:./dev.db"
# Production PostgreSQL: "postgresql://username:password@localhost:5432/studioza"
DATABASE_URL="file:./dev.db"

# Backend Port & Secret
PORT=5000
JWT_SECRET=your_jwt_secret_key

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"
